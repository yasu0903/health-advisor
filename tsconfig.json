{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    // 依存(agents / workers-oauth-provider)が @cloudflare/workers-types v4 で
    // ビルドされているため、プロジェクト全体もこれを単一の型ソースにして整合させる。
    // wrangler v4 の `wrangler types` が生成する worker-configuration.d.ts は
    // v5系ランタイム型を含み Headers 等が二重化・衝突するため include しない。
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
